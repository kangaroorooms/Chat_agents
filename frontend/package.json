{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier --write \"**/*.{js,ts,tsx,jsx,json,css,scss,md,html,yml,yaml}\" --ignore-path .prettierignore",
